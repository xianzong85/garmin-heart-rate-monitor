.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  text-align: center;
  padding: 20rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.content {
  width: 100%;
}

.status-box {
  margin: 20rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  text-align: center;
}

.status-box.connected {
  background-color: #d4edda;
}

.status-text {
  font-size: 28rpx;
  color: #333;
}

.heart-rate-box {
  margin: 40rpx 0;
  text-align: center;
}

.heart-rate {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.heart-rate-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #dc3545;
}

.heart-rate-unit {
  font-size: 32rpx;
  color: #666;
  margin-left: 10rpx;
}

.tips {
  width: 90%;
  background-color: #f8f9fa;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.tips-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.tips-text-first {
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status {
  width: 90%;
  text-align: center;
  margin: 20rpx 0;
}

.heart-rate {
  font-size: 48rpx;
  color: #dc3545;
  font-weight: bold;
  display: block;
  margin-top: 10rpx;
}

.device-list {
  width: 90%;
  margin: 20rpx 0;
  background: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.device-list-header {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
}

.device-count {
  color: #666;
  margin-left: 10rpx;
  font-size: 24rpx;
}

.device-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-item:active {
  background-color: #f5f5f5;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 32rpx;
  color: #333;
  display: block;
}

.device-id {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.rssi {
  font-size: 24rpx;
  color: #666;
  margin-left: 20rpx;
}

.chart-container {
  width: 100%;
  padding: 20rpx;
  background: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin: 20rpx 0;
}

.chart-wrapper {
  width: 100%;
  height: 300px;
  position: relative;
}

.chart {
  width: 100% !important;
  height: 100% !important;
  position: absolute;
  left: 0;
  top: 0;
}

.button-group {
  margin: 40rpx 20rpx;
}

.buttons {
  width: 90%;
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
}

.search-btn, .disconnect-btn {
  width: 45% !important;
}

.search-btn[disabled], .disconnect-btn[disabled] {
  opacity: 0.6;
}
