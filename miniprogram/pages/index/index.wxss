/* 全局样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f6fa;
}

/* 顶部状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.status-text {
  font-size: 28rpx;
  color: #666;
}

.search-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #007AFF;
  border-radius: 30rpx;
  color: #fff;
  font-size: 26rpx;
  transition: all 0.3s;
}

.search-btn.searching {
  background: #999;
}

.search-btn .iconfont {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* 设备列表 */
.device-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s;
}

.device-item:last-child {
  border-bottom: none;
}

.device-item:active {
  background: #f9f9f9;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.device-id {
  font-size: 24rpx;
  color: #999;
}

.device-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.device-status.DISCONNECTED .status-dot {
  background: #999;
}

.device-status.CONNECTING .status-dot {
  background: #FFA500;
  animation: pulse 1.5s infinite;
}

.device-status.CONNECTED .status-dot {
  background: #4CD964;
}

.device-status.ERROR .status-dot {
  background: #FF3B30;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

/* 动画 */
@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.5;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 提示区域 */
.tips {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tips-text {
  display: block;
  color: #666;
  font-size: 28rpx;
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.tips-text-first {
  color: #333;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

/* 状态区域 */
.status {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  font-size: 32rpx;
  color: #333;
}

.pk-timer {
  display: block;
  margin-top: 16rpx;
  color: #f56c6c;
  font-weight: 500;
  font-size: 36rpx;
}

.device-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 已连接设备 */
.connected-devices {
  margin-bottom: 30rpx;
}

.device-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  transition: all 0.3s;
}

.device-panel:last-child {
  margin-bottom: 0;
}

.device-panel.active {
  border: 2rpx solid #67c23a;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.heart-rate {
  font-size: 48rpx;
  font-weight: 600;
  color: #f56c6c;
  display: block;
}

.heart-rate.pulse {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

.unit {
  font-size: 24rpx;
  color: #909399;
  font-weight: normal;
}

.rank {
  display: block;
  font-size: 28rpx;
  color: #67c23a;
  margin-top: 8rpx;
  font-weight: 500;
}

.chart-container {
  width: 100%;
  height: 300rpx;
  position: relative;
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.chart {
  width: 100% !important;
  height: 100% !important;
  position: absolute;
  left: 0;
  top: 0;
}

/* 按钮样式 */
.button-group {
  padding: 30rpx;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.pk-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #67c23a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  transition: all 0.3s;
}

.pk-btn:active {
  opacity: 0.9;
}

.pk-btn.pk-active {
  background: #f56c6c;
}

.pk-btn[disabled] {
  background: #b3e19d;
  opacity: 1;
}

/* 添加动画相关的样式 */
@keyframes searching {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.95); opacity: 0.8; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes dot {
  0% { transform: scale(0.3); opacity: 0.3; }
  50% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.3); opacity: 0.3; }
}

/* 状态图标 */
.status-icon {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  border: 4rpx solid #409eff;
  border-top-color: transparent;
  display: none;
}

.status-icon.searching {
  display: block;
  animation: rotate 1s linear infinite;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  background: #409eff;
  border-radius: 50%;
}

.dot:nth-child(1) { animation: dot 1s infinite 0s; }
.dot:nth-child(2) { animation: dot 1s infinite 0.2s; }
.dot:nth-child(3) { animation: dot 1s infinite 0.4s; }

/* 按钮加载状态 */
.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #fff;
  border-top-color: transparent;
  border-radius: 50%;
  animation: rotate 1s linear infinite;
}

/* 断开连接按钮 */
.device-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.disconnect-btn {
  font-size: 24rpx;
  color: #f56c6c;
  padding: 8rpx 20rpx;
  border: 1rpx solid #f56c6c;
  border-radius: 24rpx;
  transition: all 0.3s;
}

.disconnect-btn:active {
  background: #fff3f3;
}

/* 提示文本 */
.refresh-hint {
  font-size: 24rpx;
  color: #909399;
}

.header-left, .header-right {
  display: flex;
  align-items: center;
}

.status-indicator {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 16rpx;
}

.status-indicator.disconnected {
  background: rgba(144, 147, 153, 0.1);
}

.status-indicator.connecting {
  background: rgba(255, 164, 0, 0.1);
}

.status-indicator.connected {
  background: rgba(39, 194, 129, 0.1);
}

.status-indicator.reconnecting {
  background: rgba(255, 164, 0, 0.1);
}

.status-indicator.error {
  background: rgba(255, 71, 87, 0.1);
}

.status-text {
  font-size: 24rpx;
  color: #606266;
}

@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

/* 电量指示器 */
.battery-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 16rpx;
}

.battery-icon {
  width: 40rpx;
  height: 20rpx;
  border: 2rpx solid #909399;
  border-radius: 4rpx;
  padding: 2rpx;
  position: relative;
}

.battery-icon:after {
  content: '';
  position: absolute;
  right: -6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 10rpx;
  background: #909399;
  border-radius: 0 2rpx 2rpx 0;
}

.battery-level {
  height: 100%;
  background: #67c23a;
  border-radius: 2rpx;
}

.battery-level[style*="width: 20%"],
.battery-level[style*="width: 1"],
.battery-level[style*="width: 2"],
.battery-level[style*="width: 3"],
.battery-level[style*="width: 4"],
.battery-level[style*="width: 5"],
.battery-level[style*="width: 6"],
.battery-level[style*="width: 7"],
.battery-level[style*="width: 8"],
.battery-level[style*="width: 9%"] {
  background: #f56c6c;
}

.battery-text {
  font-size: 24rpx;
  color: #909399;
}

/* 使用说明卡片 */
.guide-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.guide-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.guide-header .iconfont {
  font-size: 36rpx;
  color: #007AFF;
  margin-right: 12rpx;
}

.guide-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  background: #007AFF;
  color: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
}

.step-text {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

/* 状态显示卡片 */
.status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.status-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #f0f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon .iconfont {
  font-size: 48rpx;
  color: #007AFF;
}

.status-icon.searching .iconfont {
  animation: rotate 1s linear infinite;
}

.status-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* 加载动画点 */
.loading-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #007AFF;
  border-radius: 50%;
  animation: dot 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* PK计时器 */
.pk-timer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f5f5f5;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
}

.timer-label {
  font-size: 28rpx;
  color: #666;
}

.timer-value {
  font-size: 48rpx;
  color: #f56c6c;
  font-weight: 600;
  font-family: monospace;
}

.timer-unit {
  font-size: 24rpx;
  color: #999;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes dot {
  0%, 80%, 100% { transform: scale(0.3); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}
