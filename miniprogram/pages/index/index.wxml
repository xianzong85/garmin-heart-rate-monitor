<view class="container">
  <!-- 使用说明卡片 -->
  <view class="guide-card">
    <view class="guide-header">
      <text class="iconfont icon-info"></text>
      <text class="guide-title">使用说明</text>
    </view>
    <view class="guide-steps">
      <view class="guide-step">
        <text class="step-number">1</text>
        <text class="step-text">请先在手机上关闭佳明Connect应用</text>
      </view>
      <view class="guide-step">
        <text class="step-number">2</text>
        <text class="step-text">确保手表已开启并在附近</text>
      </view>
      <view class="guide-step">
        <text class="step-number">3</text>
        <text class="step-text">点击下方按钮开始搜索</text>
      </view>
      <view class="guide-step">
        <text class="step-number">4</text>
        <text class="step-text">连接多个设备后可以开始PK</text>
      </view>
    </view>
  </view>

  <!-- 状态显示卡片 -->
  <view class="status-card">
    <view class="status-content">
      <view class="status-icon {{isSearching ? 'searching' : ''}}">
        <text class="iconfont {{isSearching ? 'icon-loading' : 'icon-bluetooth'}}"></text>
      </view>
      <text class="status-text">{{statusText}}</text>
      <view class="loading-dots" wx:if="{{isSearching}}">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
    <block wx:if="{{isPKMode}}">
      <view class="pk-timer">
        <text class="timer-label">剩余时间</text>
        <text class="timer-value">{{pkTimeLeft}}</text>
        <text class="timer-unit">秒</text>
      </view>
    </block>
  </view>

  <!-- 设备列表 -->
  <view class="device-list">
    <block wx:if="{{devices.length > 0}}">
      <view class="device-item" wx:for="{{devices}}" wx:key="deviceId" bindtap="connectToDevice" data-device="{{item}}">
        <view class="device-info">
          <view class="device-name">{{item.name || '未知设备'}}</view>
          <view class="device-id">{{item.deviceId}}</view>
        </view>
        <view class="device-status {{item.connectionState}}">
          <text class="status-dot"></text>
          <text>{{item.statusText}}</text>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:else>
      <image class="empty-icon" src="/images/bluetooth.png" mode="aspectFit"></image>
      <text class="empty-text">未发现设备</text>
      <text class="empty-tip">请确保设备已开启并在范围内</text>
    </view>
  </view>

  <!-- 已连接设备 -->
  <view class="connected-devices" wx:if="{{connectedDeviceList.length > 0}}">
    <view class="device-panel" wx:for="{{connectedDeviceList}}" wx:key="deviceId">
      <view class="device-header">
        <text class="device-name">{{item.name}}</text>
        <view class="device-status">
          <text class="heart-rate {{item.heartRate ? 'pulse' : ''}}">
            {{item.heartRate || '--'}} <text class="unit">BPM</text>
          </text>
          <text wx:if="{{isPKMode}}" class="rank">第{{item.rank}}名</text>
        </view>
      </view>
      <view class="chart-container">
        <canvas type="2d" id="heartRateChart_{{item.deviceId}}" class="chart" style="width: 100%; height: 100%;"></canvas>
      </view>
    </view>
  </view>

  <view class="button-group">
    <view class="search-btn {{isSearching ? 'searching' : ''}}" bindtap="startSearch">
      <text class="iconfont icon-search"></text>
      <text>{{isSearching ? '搜索中...' : '搜索设备'}}</text>
    </view>

    <block wx:if="{{Object.keys(connectedDevices).length > 0}}">
      <button class="pk-btn {{isPKMode ? 'pk-active' : ''}}" 
              bindtap="{{isPKMode ? 'endPK' : 'startPK'}}">
        {{isPKMode ? '结束PK' : '开始PK'}}
      </button>
    </block>
  </view>
</view>