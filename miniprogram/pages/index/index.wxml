<view class="container">
  <view class="tips">
    <text class="tips-text tips-text-first">使用说明：</text>
    <text class="tips-text">1. 请先在手机上关闭佳明Connect应用</text>
    <text class="tips-text">2. 确保手表已开启并在附近</text>
    <text class="tips-text">3. 点击下方按钮开始搜索</text>
    <text class="tips-text">4. 连接多个设备后可以开始PK</text>
  </view>

  <view class="status">
    <text>{{statusText}}</text>
    <block wx:if="{{isPKMode}}">
      <text class="pk-timer">剩余时间: {{pkTimeLeft}}秒</text>
    </block>
  </view>

  <!-- 设备列表 -->
  <view class="device-list" wx:if="{{devices.length > 0}}">
    <view class="device-list-header">
      <text>可用设备</text>
      <text class="device-count">({{devices.length}})</text>
    </view>
    <view class="device-item" wx:for="{{devices}}" wx:for-index="deviceId" wx:for-item="device" wx:key="deviceId" bindtap="connectToDevice" data-device="{{device}}">
      <view class="device-info">
        <text class="device-name">{{device.name || '未知设备'}}</text>
        <text class="device-id">ID: {{device.deviceId}}</text>
      </view>
      <text class="rssi">信号: {{device.RSSI}} dBm</text>
    </view>
  </view>

  <!-- 已连接设备 -->
  <view class="connected-devices" wx:if="{{connectedDeviceList.length > 0}}">
    <view class="device-panel" wx:for="{{connectedDeviceList}}" wx:key="deviceId">
      <view class="device-header">
        <text class="device-name">{{item.name}}</text>
        <view class="device-status">
          <text class="heart-rate {{item.heartRate ? 'pulse' : ''}}">
            {{item.heartRate || '--'}} <text class="unit">BPM</text>
          </text>
          <text wx:if="{{isPKMode}}" class="rank">第{{item.rank}}名</text>
        </view>
      </view>
      <view class="chart-container">
        <canvas type="2d" id="heartRateChart_{{item.deviceId}}" class="chart" style="width: 100%; height: 100%;"></canvas>
      </view>
    </view>
  </view>

  <view class="button-group">
    <button class="search-btn" 
            bindtap="startSearch" 
            disabled="{{isSearching}}">
      {{isSearching ? '正在搜索...' : '搜索设备'}}
    </button>

    <block wx:if="{{Object.keys(connectedDevices).length > 0}}">
      <button class="pk-btn {{isPKMode ? 'pk-active' : ''}}" 
              bindtap="{{isPKMode ? 'endPK' : 'startPK'}}">
        {{isPKMode ? '结束PK' : '开始PK'}}
      </button>
    </block>
  </view>
</view>