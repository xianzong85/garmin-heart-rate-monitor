<view class="pk-container {{isLandscape ? 'landscape' : ''}}">
  <view class="pk-header">
    <view class="pk-timer-container" wx:if="{{isPKMode}}">
      <view class="pk-timer">
        <text class="timer-label">倒计时</text>
        <text class="timer-value">{{pkTimeLeft}}</text>
        <text class="timer-unit">秒</text>
      </view>
      <view class="timer-progress-bar">
        <view class="timer-progress" style="width: {{(pkTimeLeft/pkDuration)*100}}%"></view>
      </view>
    </view>
    <view class="pk-controls">
      <button class="control-btn {{isPKMode ? 'active' : ''}}" bindtap="togglePK">
        <text class="btn-icon {{isPKMode ? 'icon-stop' : 'icon-play'}}"></text>
        <text>{{isPKMode ? '结束PK' : '开始PK'}}</text>
      </button>
      <button class="control-btn add-device" bindtap="showSearchDevices">
        <text class="btn-icon icon-add"></text>
        <text>添加设备</text>
      </button>
      <button class="control-btn orientation" bindtap="toggleOrientation">
        <text class="btn-icon {{isLandscape ? 'icon-portrait' : 'icon-landscape'}}"></text>
        <text>{{isLandscape ? '竖屏' : '横屏'}}</text>
      </button>
      <button class="control-btn screen-connect {{isConnectedToScreen ? 'connected' : ''}}" bindtap="{{isConnectedToScreen ? 'disconnectFromScreen' : 'showScreenConnectModal'}}">
        <text class="btn-icon icon-screen"></text>
        <text>{{isConnectedToScreen ? '断开大屏' : '连接大屏'}}</text>
      </button>
    </view>
  </view>

  <view class="pk-main">
    <!-- 设备列表部分 - 始终显示，作为主要内容 -->
    <view class="device-status">
      <view class="device-card {{item.isLeading ? 'leading' : ''}} {{isPKMode && item.rank === 1 ? 'first-place' : ''}} {{isPKMode && item.rank === 2 ? 'second-place' : ''}} {{isPKMode && item.rank === 3 ? 'third-place' : ''}}"
            wx:for="{{connectedDeviceList}}"
            wx:key="deviceId">
        <view class="device-header">
          <view class="device-info">
            <view class="device-name">{{item.name}}</view>
            <view class="connection-status {{item.isConnected ? 'connected' : 'disconnected'}}">
              <view class="status-dot"></view>
              <text>{{item.isConnected ? '已连接' : '已断开'}}</text>
            </view>
          </view>
          <view class="device-rank" wx:if="{{isPKMode}}">
            <view class="rank-badge rank-{{item.rank}}">
              <text>{{item.rank}}</text>
            </view>
          </view>
        </view>

        <view class="heart-rate {{item.isWorn && !isPKMode ? 'pulse-animation' : ''}}">
          <view class="heart-icon {{item.isWorn ? 'beating' : 'inactive'}}">
            <text class="icon-heart"></text>
          </view>
          <view class="heart-rate-display">
            <block wx:if="{{item.isWorn === false}}">
              <text class="heart-rate-value not-worn">未佩戴</text>
              <text wx:if="{{item.unwornDuration}}" class="heart-rate-duration">{{item.unwornDuration}}秒</text>
            </block>
            <block wx:else>
              <text class="heart-rate-value">{{item.heartRate || '--'}}</text>
              <text class="heart-rate-unit">BPM</text>
            </block>
          </view>
        </view>

        <!-- 心率统计数据 -->
        <view class="stats" wx:if="{{(item.maxHeartRate && item.isWorn !== false) || item.historicalMaxHeartRate}}">
          <view class="stat-item">
            <text class="stat-label">最高</text>
            <text class="stat-value">{{item.isWorn !== false && item.maxHeartRate ? item.maxHeartRate : (item.historicalMaxHeartRate || '--')}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">最低</text>
            <text class="stat-value">{{item.isWorn !== false && item.minHeartRate ? item.minHeartRate : (item.historicalMinHeartRate || '--')}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">平均</text>
            <text class="stat-value">{{item.isWorn !== false && item.avgHeartRate ? item.avgHeartRate : (item.historicalAvgHeartRate ? item.historicalAvgHeartRate.toFixed(1) : '--')}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态提示 -->
      <view class="empty-devices" wx:if="{{connectedDeviceList.length === 0}}">
        <view class="empty-icon">📱</view>
        <text class="empty-text">暂无已连接设备</text>
        <text class="empty-subtext">点击“添加设备”按钮连接设备</text>
      </view>
    </view>

    <!-- 心率图表部分 - 仅在PK模式下显示 -->
    <view class="chart-section" wx:if="{{isPKMode}}">
      <view class="chart-header">
        <text class="chart-title">实时心率</text>
        <view class="chart-legend" wx:if="{{connectedDeviceList.length > 0}}">
          <view class="legend-item" wx:for="{{connectedDeviceList}}" wx:key="deviceId">
            <view class="legend-color" style="background-color: {{item.lineColor}}"></view>
            <text class="legend-name">{{item.name}}</text>
          </view>
        </view>
      </view>
      <view class="canvas-container">
        <canvas canvas-id="pkChart" class="pk-chart"></canvas>
      </view>
      <view class="chart-fallback" wx:if="{{!chartRendered}}">
        <view class="device-line" wx:for="{{connectedDeviceList}}" wx:key="deviceId" style="color: {{item.isWorn === false ? '#909399' : item.lineColor}}">
          <text>{{item.name}}:
            <block wx:if="{{item.isWorn === false}}">未佩戴</block>
            <block wx:else>{{item.heartRate || '--'}} BPM</block>
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索设备弹窗 -->
  <view class="search-modal {{showSearchModal ? 'visible' : ''}}">
    <view class="modal-mask" bindtap="hideSearchModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-title">搜索设备</view>
        <view class="modal-close" bindtap="hideSearchModal">×</view>
      </view>

      <view class="status-card {{isSearching ? 'searching' : ''}}">
        <view class="status-content">
          <view class="status-icon">
            <view class="bluetooth-icon {{isSearching ? 'pulse' : ''}}">
              <text class="icon-bluetooth"></text>
            </view>
            <view class="search-waves" wx:if="{{isSearching}}">
              <view class="wave wave1"></view>
              <view class="wave wave2"></view>
              <view class="wave wave3"></view>
            </view>
          </view>
          <text class="status-text">{{statusText}}</text>
        </view>
      </view>

      <view class="device-list">
        <block wx:if="{{devices.length > 0}}">
          <view class="device-item {{item.connectionState === 'connecting' ? 'connecting' : ''}}"
                wx:for="{{devices}}"
                wx:key="deviceId"
                bindtap="connectToDevice"
                data-device="{{item}}">
            <view class="device-info">
              <view class="device-name">{{item.name || '未知设备'}}</view>
              <view class="device-id">{{item.deviceId}}</view>
            </view>
            <view class="device-status {{item.connectionState}}">
              <view class="status-indicator">
                <text class="status-dot"></text>
                <text>{{item.statusText}}</text>
              </view>
              <view class="connect-arrow" wx:if="{{item.connectionState !== 'connected'}}">→</view>
            </view>
          </view>
        </block>
        <view class="empty-state" wx:else>
          <view class="empty-icon-container">
            <text class="empty-icon icon-bluetooth-off"></text>
          </view>
          <text class="empty-text">未发现设备</text>
          <text class="empty-tip">请确保设备已开启并在范围内</text>
        </view>
      </view>

      <view class="modal-footer">
        <button class="search-btn {{isSearching ? 'searching' : ''}}" bindtap="startSearch">
          <view class="btn-content">
            <text class="btn-icon icon-search"></text>
            <text>{{isSearching ? '搜索中...' : '重新搜索'}}</text>
          </view>
        </button>
      </view>
    </view>
  </view>

  <!-- PK结果弹窗 -->
  <view class="pk-result-modal" wx:if="{{showPKResult}}">
    <view class="modal-mask" bindtap="hidePKResult"></view>
    <view class="result-content">
      <view class="result-header">
        <text class="result-title">PK结果</text>
        <view class="modal-close" bindtap="hidePKResult">×</view>
      </view>

      <view class="result-podium">
        <view class="podium-item second" wx:if="{{pkResults.length > 1}}">
          <view class="podium-avatar">2</view>
          <view class="podium-name">{{pkResults[1].name}}</view>
          <view class="podium-value">{{pkResults[1].heartRate || '--'}} BPM</view>
        </view>

        <view class="podium-item first" wx:if="{{pkResults.length > 0}}">
          <view class="podium-crown">👑</view>
          <view class="podium-avatar">1</view>
          <view class="podium-name">{{pkResults[0].name}}</view>
          <view class="podium-value">{{pkResults[0].heartRate || '--'}} BPM</view>
        </view>

        <view class="podium-item third" wx:if="{{pkResults.length > 2}}">
          <view class="podium-avatar">3</view>
          <view class="podium-name">{{pkResults[2].name}}</view>
          <view class="podium-value">{{pkResults[2].heartRate || '--'}} BPM</view>
        </view>
      </view>

      <view class="result-list">
        <view class="result-item" wx:for="{{pkResults}}" wx:key="deviceId" wx:if="{{index > 2}}">
          <view class="result-rank">{{index + 1}}</view>
          <view class="result-name">{{item.name}}</view>
          <view class="result-value">{{item.heartRate || '--'}} BPM</view>
        </view>
      </view>

      <view class="result-footer">
        <button class="result-btn" bindtap="hidePKResult">确定</button>
      </view>
    </view>
  </view>

  <!-- 大屏幕连接弹窗 -->
  <view class="user-select-mask" wx:if="{{showScreenConnectModal}}" bindtap="hideScreenConnectModal"></view>
  <view class="user-select-modal" wx:if="{{showScreenConnectModal}}">
    <view class="user-select-header">
      <text class="user-select-title">连接大屏幕</text>
      <view class="user-select-close" bindtap="hideScreenConnectModal">×</view>
    </view>
    <view class="user-select-content">
      <form bindsubmit="connectToScreen">
        <view class="input-group">
          <text class="input-label">房间ID</text>
          <input class="input-field" name="roomId" placeholder="请输入房间ID" value="{{screenRoomId}}" bindinput="handleRoomIdInput" />
        </view>
      </form>
    </view>
    <view class="user-select-footer">
      <button class="user-select-cancel" bindtap="hideScreenConnectModal">取消</button>
      <button class="user-select-confirm" bindtap="connectToScreen">连接</button>
    </view>
  </view>
</view>

<!-- 选择使用人弹窗 -->
<view class="user-select-mask" wx:if="{{showUserSelectModal}}" bindtap="cancelUserSelection"></view>
<view class="user-select-modal" wx:if="{{showUserSelectModal}}">
  <view class="user-select-header">
    <text class="user-select-title">选择使用人</text>
    <view class="user-select-close" bindtap="cancelUserSelection">×</view>
  </view>
  <scroll-view scroll-y class="user-select-content">
    <view class="user-select-list">
      <view class="user-select-item {{selectedMemberId === item.id ? 'selected' : ''}}"
            wx:for="{{familyMembers}}"
            wx:key="id"
            bindtap="selectUser"
            data-id="{{item.id}}">
        <view class="user-select-avatar">
          <text class="user-select-initial">{{item.nickname[0]}}</text>
        </view>
        <text class="user-select-name">{{item.nickname}}</text>
      </view>
    </view>
  </scroll-view>
  <view class="user-select-footer">
    <button class="user-select-cancel" bindtap="cancelUserSelection">取消</button>
    <button class="user-select-confirm" bindtap="confirmUserSelection">确定</button>
  </view>
</view>