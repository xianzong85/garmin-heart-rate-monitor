}

.stat-item {
  text-align: center;
}

.stat-item .label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.stat-item .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.connection-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 16rpx;
}

.connection-status.connected {
  background-color: rgba(103, 194, 58, 0.1);
  color: #67c23a;
}

.connection-status.disconnected {
  background-color: rgba(245, 108, 108, 0.1);
  color: #f56c6c;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.connected .status-dot {
  background-color: #67c23a;
  animation: pulse 2s infinite;
}

.disconnected .status-dot {
  background-color: #f56c6c;
}

@keyframes pulse {
  0% {
    transform: scale(0.95);
    box-shadow: 0 0 0 0 rgba(103, 194, 58, 0.4);
  }

  70% {
    transform: scale(1);
    box-shadow: 0 0 0 6rpx rgba(103, 194, 58, 0);
  }

  100% {
    transform: scale(0.95);
    box-shadow: 0 0 0 0 rgba(103, 194, 58, 0);
  }
}

/* 添加大屏幕连接相关样式 */
.control-btn.screen-connect {
  background-color: #f5f6fa;
  color: #606266;
}

.control-btn.screen-connect.connected {
  background-color: #e1f3d8;
  color: #67c23a;
}

/* 大屏幕连接弹窗 */
.screen-connect-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.screen-connect-modal .modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1002;
  padding: 30rpx;
  animation: modalFadeIn 0.3s ease;
}

.screen-connect-modal .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.screen-connect-modal .modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.screen-connect-modal .modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
  padding: 10rpx;
}

.screen-connect-modal .input-group {
  margin-bottom: 30rpx;
}

.screen-connect-modal .input-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.screen-connect-modal .input-field {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.screen-connect-modal .connect-btn {
  width: 100%;
  height: 88rpx;
  background: #007AFF;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.screen-connect-modal .connect-btn:active {
  opacity: 0.9;
}