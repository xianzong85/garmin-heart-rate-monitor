}

.legend-name {
  font-size: 24rpx;
  color: #666;
}

/* 设备状态区域 */
.devices-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-card {
  background: #fff;
