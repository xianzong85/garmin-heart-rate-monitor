  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.pk-btn.active {
  background: #f56c6c;
}

.pk-btn:active {
  opacity: 0.8;
}

/* 主要内容区域 */
.main-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
}

.landscape .main-content {
